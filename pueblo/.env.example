# Sentry project > Settings > Client Keys (DSN)
VITE_SENTRY_DSN=
# Development only: set true to test event delivery locally.
VITE_SENTRY_ENABLED=false
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
# API base URL including its path prefix. Defaults to /api on the current origin.
VITE_API_BASE_URL=
# Authentication server origin for local development (scheme + host + port).
# Empty defaults to localhost:8081 in development, current origin in production.
VITE_AUTH_API_ORIGIN=
